# Copy this file to .env.local and replace the value for local development.
# Never put database credentials, passwords, private tokens, or secret API keys in VITE_* variables.
# VITE_* values are included in the browser bundle and are visible to users.
VITE_API_BASE_URL=http://localhost:8080
# OpenAI API Key (PDF 요약 기능에 사용)
VITE_OPENAI_API_KEY=your-openai-api-key-here
